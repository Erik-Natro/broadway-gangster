---
import '../styles/global.css';
import { url } from '../utils/url';
const { title, description = 'Die Leipziger „Broadway-Gangster“: Jugendlicher Widerstand und Eigensinn im Nationalsozialismus.' } = Astro.props;
const strip = (p: string) => p.replace(/\/$/, '');
const path = strip(Astro.url.pathname);
const nav = [
  ['/', 'Start'],
  ['/geschichte/', 'Die Gruppe'],
  ['/karte/', 'Karte'],
  ['/zeitzeugen/', 'Zeitzeugen'],
  ['/quellen/', 'Quellen'],
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Broadway-Gangster</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={url('/')}>Broadway-Gangster</a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={url(href)} aria-current={path === strip(url(href)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">Schulprojekt Geschichte/Gemeinschaftskunde | Erik Mehnert | T2-25</div>
    </footer>
  </body>
</html>
