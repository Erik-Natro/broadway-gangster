---
import '../styles/global.css';
const { title, description = 'Die Leipziger „Broadway-Gangster“: Jugendlicher Widerstand und Eigensinn im Nationalsozialismus.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/', 'Start'],
  ['/geschichte/', 'Die Gruppe'],
  ['/zeitzeugen/', 'Zeitzeugen'],
  ['/quellen/', 'Quellen'],
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Broadway-Gangster</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Broadway-Gangster</a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">Schulprojekt Geschichte · Leipzig im Nationalsozialismus</div>
    </footer>
  </body>
</html>
